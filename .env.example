# Relay (Render). Prefer the hash so the public relay never needs the raw tunnel secret.
PORT=10000
RELAY_AGENT_TOKEN_SHA256=replace-with-64-char-sha256-of-the-central-agent-token
SITE_DIR=site
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-supabase-publishable-key

# Target runtime after the Supabase migration. On the Lightsail, use the Unix
# socket URL below with PostgreSQL peer authentication; no database password is
# stored in the application environment. During migration, omit DATABASE_URL to
# keep the Supabase fallback active.
# DATABASE_URL=postgresql:///fecart?host=/var/run/postgresql

# Local one-machine mode: `npm run local` keeps Supabase external and starts
# both the relay and the host-agent on this computer. The launcher gives the
# relay only the publishable key and keeps the secret key in the host process.
# These are optional.
# LOCAL_RELAY_HOST=127.0.0.1
# LOCAL_RELAY_PORT=10000

# Central host only. Do not copy CODEX_HOME, CODEX_BIN, or this raw token to a remote PC.
RELAY_URL=wss://your-relay.onrender.com
RELAY_AGENT_TOKEN=replace-with-a-long-random-central-agent-token
RELAY_HOST_ID=central-main
CODEX_BIN=codex
APP_SERVER_PORT=4500
APP_SERVER_START_TIMEOUT_MS=30000
# If omitted, a temporary local file under the OS temp directory is used.
# CODEX_APP_SERVER_TOKEN_FILE=C:\Users\you\AppData\Local\Codex\app-server.token
# CODEX_HOME=C:\Users\you\.codex

# Transitional fallback only. Remove after DATABASE_URL is active and accepted.
SUPABASE_SECRET_KEY=sb_secret_replace-with-secret-key
# Legacy fallback only, if the project has not migrated its backend key yet.
# SUPABASE_SERVICE_ROLE_KEY=replace-with-legacy-service-role-key
REMOTE_CODEX_STATE_DIR=C:\Users\you\.remote-codex
CODEX_ACCOUNT_REGISTRY=C:\Users\you\.remote-codex\accounts.json
CODEX_ACCOUNTS_DIR=C:\Users\you\.remote-codex\accounts
ACCOUNT_REFRESH_INTERVAL_MS=60000

# Optional tuning for the central host.
ACCESS_SYNC_INTERVAL_MS=1000
RELAY_HEARTBEAT_INTERVAL_MS=5000

# Instalar como /etc/fecart/postgres-backup.env, owner root, mode 0640.
# Prefira PGPASSFILE root-only ou autenticação peer em vez de senha nesta URL.
DATABASE_URL=postgresql:///fecart?host=/var/run/postgresql
BACKUP_ROOT=/var/backups/fecart/postgres
S3_BUCKET=replace-with-private-backup-bucket
S3_PREFIX=fecart/postgres
AWS_REGION=us-west-2
# Se a instância não tiver uma identidade AWS adequada, use uma credencial IAM
# exclusiva e limitada ao prefixo acima. Nunca a versione.
# AWS_ACCESS_KEY_ID=replace-with-dedicated-key
# AWS_SECRET_ACCESS_KEY=replace-with-dedicated-secret
